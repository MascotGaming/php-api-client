{
    "name": "mascotgaming/php-api-client",
    "homepage": "https://github.com/MascotGaming/php-api-client",
    "description": "Operator API v1 client for PHP.",
    "require": {
        "php": ">=5.6.1",
        "fguillot/json-rpc": "1.2.5",
        "phpseclib/phpseclib": "~3.0",
        "ext-curl": "*",
        "ext-openssl": "*"
    },
    "autoload": {
        "psr-4": {
            "mascotgaming\\mascot\\api\\client\\": "src"
        }
    },
    "require-dev": {
      "phpunit/phpunit": "^5.7 || ^12.0"
    },
    "scripts": {
        "lint": "find src tests -name \"*.php\" -print0 | xargs -0 -n1 php -l",
        "test": "vendor/bin/phpunit tests",
        "check": [
            "@lint",
            "composer validate",
            "composer check-platform-reqs",
            "@test"
        ]
    }
}
